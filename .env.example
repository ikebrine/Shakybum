# Read by src/lib/api.js — this is the base URL every fetch call in the
# frontend is built from (auth, contact requests, Bum sessions, chat,
# notifications). Required for the app to do anything beyond the auth
# screens; without it, requests fall back to http://localhost:4000/api,
# which won't resolve to anything once deployed.
#
# Set this in Vercel's dashboard (Project Settings → Environment Variables)
# — Vite only exposes vars prefixed VITE_ to client code — then redeploy
# (env var changes don't trigger an automatic rebuild).
#
# Two backend options exist, pick the one you actually deployed:
#   Node/Express on Railway/Render:  https://your-backend.up.railway.app/api
#   Supabase Edge Function:          https://<project-ref>.supabase.co/functions/v1/api
VITE_API_BASE_URL="https://your-backend-url.com/api"
