# Copy to .env and fill in real values. Never commit .env — it's already in .gitignore.

DATABASE_PATH="./dev.db"

# JWT signing secret — generate a real random one: `openssl rand -hex 32`
JWT_SECRET="change-me-to-a-random-64-char-hex-string"
JWT_EXPIRES_IN="7d"

# Paystack (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Leave unset in production — only used to point at scripts/mock-paystack-server.js
# for local testing without hitting the real Paystack API.
# PAYSTACK_BASE_URL="http://localhost:5555"
# Set this in the Paystack dashboard webhook config to point at:
#   https://your-deployed-backend.com/api/webhooks/paystack
# Paystack signs webhook payloads with your secret key (see lib/paystack.js) —
# there's no separate webhook secret to configure.

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Platform's cut of every contact-reveal / Bum-session payment (0.30 = 30%)
PLATFORM_CUT=0.30
